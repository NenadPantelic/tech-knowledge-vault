# Application
APP_NAME=book-enrichment-service
LOG_LEVEL=INFO
PORT=5000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENRICHMENT_REQUESTS_TOPIC=book-enrichment-requests
KAFKA_ENRICHMENT_RESULTS_TOPIC=book-enrichment-results
KAFKA_CONSUMER_GROUP=book-enrichment-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_TIMEOUT_IN_SEC=5.0